# Copy this file to `.env` and fill in the values you need.
#
#     cp .env.example .env
#
# `.env` is gitignored and must stay that way — it holds real secrets.
# This file is committed, so it must never hold one. Node reads .env itself
# (--env-file-if-exists in the npm scripts); there is no dotenv package.
#
# Every variable is optional. Each one that is missing turns its feature OFF
# rather than leaving it open — an unconfigured server is a locked one.


# ---------------------------------------------------------------------
# Admin token for the newsletter API
# ---------------------------------------------------------------------
# Protects: GET /api/subscribers, /api/messages, /api/stats,
#           POST /api/unsubscribe, /api/export
#
# UNSET means those routes refuse EVERYONE, including you. It does not mean
# they are open. Generate one with:
#
#     npm run token
#
IKSHAA_API_TOKEN=


# ---------------------------------------------------------------------
# Groq — used to route a stuck conversation, never to write a reply
# ---------------------------------------------------------------------
# Reached only after the local matcher has missed twice, or when the guest
# asks for it. The model returns ONE topic id from a closed list; the words
# the guest reads are still rendered from public/chat/knowledge.js.
#
# UNSET means the chat behaves exactly as it did before — the escalation
# simply falls through to the human handoff.
#
# Key from https://console.groq.com/keys (free tier is ample for this).
GROQ_API_KEY=

# Hard ceiling on router calls per day, across all visitors. The per-address
# limit stops one caller hammering it; this stops a thousand callers doing it
# once each, which is what actually empties a balance overnight.
# Default 300 if unset.
GROQ_DAILY_CAP=300

# Which model routes the question. Default openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b


# ---------------------------------------------------------------------
# Dev server
# ---------------------------------------------------------------------
# Default 3000.
PORT=3000
