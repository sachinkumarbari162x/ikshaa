# Normalise line endings so a Windows checkout and a Linux CI runner do not
# produce diffs against each other. Without this, every file git touches
# shows as modified on one platform or the other.
* text=auto eol=lf

# Binary — never converted, never diffed as text
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.avif  binary
*.mp4   binary
*.mov   binary
*.webm  binary
*.mp3   binary
*.ico   binary
