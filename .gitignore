# Dependencies — restored by `npm ci`
node_modules/

# Build output — regenerated by `npm run build`, and by Netlify on deploy.
# Committing it would mean two sources of truth for the same files.
dist/

# A separate project that happens to live inside this one. 131 MB, with its
# own node_modules and package.json — the second package.json can confuse a
# host's build detection. The five files this site actually uses were copied
# into public/chat/ and are committed there.
# NOT deleted: still on disk at public/skeletons&Protos/.
public/skeletons&Protos/

# Superseded scaffolding kept for reference, not for shipping.
# NOT deleted: still on disk at public/_archive/.
public/_archive/

# Working files from the design process
public/*.png
public/ourHeritage.txt

# The newsletter database. Real people's addresses and messages — it is
# data, not source, and it must never reach a public repository. Recreated
# empty on first run; back it up separately.
data/

npm-debug.log*
.DS_Store
.env
.netlify/

# ---------------------------------------------------------------------
# Media the site does not reference.
#
# Derived from dist/ — the build copies only what the code actually links
# to, so this list is what was left over. 36 files, ~90 MB: the video
# master the web encode came from, six unused music tracks, guest
# Instagram reels, and images replaced during the redesign.
#
# NOT deleted. All of it is still on disk in public/; it simply is not
# carried to GitHub, because production does not need it. Keep a local
# backup of the masters — git is no longer holding a copy for you.
# ---------------------------------------------------------------------

