{
  "name": "ikshaa",
  "version": "1.0.0",
  "private": true,
  "description": "Ikshaa — a luxury heritage villa in Loutolim, South Goa. Static site, zero-dependency delivery server, and an offline chat assistant.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build": "node build.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "eval": "node eval/run.js",
    "token": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "export": "node --env-file-if-exists=.env -e \"const s=require('./api/db'),e=require('./api/export');const db=s.openDatabase('data/ikshaa.db');const o=e.writeMailingList(db,s);console.log('wrote to '+o.dir);o.files.forEach(f=>console.log('  '+f.list+': '+f.count))\"",
    "chat:probe": "node --env-file-if-exists=.env eval/probe.js",
    "chat:bench": "node --env-file-if-exists=.env eval/bench.js"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
