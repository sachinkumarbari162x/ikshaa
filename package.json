{
  "name": "ikshaa",
  "version": "1.0.0",
  "private": true,
  "description": "Ikshaa \u2014 a luxury heritage villa in Loutolim, South Goa. Static site, zero-dependency delivery server, and an offline chat assistant.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "eval": "node eval/run.js",
    "token": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=22.13"
  }
}
